{
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed", 
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/flights", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}